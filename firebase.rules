rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getFamily(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function getFamilyMember(familyId, userId) {
      return get(/databases/$(database)/documents/familyMembers/$(familyId + "_" + userId)).data;
    }
    
    // Checks if the user is a member of the family
    function isFamilyMember(familyId) {
      return isSignedIn() && exists(/databases/$(database)/documents/familyMembers/$(familyId + "_" + request.auth.uid));
    }

    // Checks if the user has the 'owner' role in the family
    function isFamilyOwner(familyId) {
      return isSignedIn() && isFamilyMember(familyId) && getFamilyMember(familyId, request.auth.uid).role == 'owner';
    }
    
    // Checks if the user has the 'admin' role in the family
    function isFamilyAdmin(familyId) {
      return isSignedIn() && isFamilyMember(familyId) && getFamilyMember(familyId, request.auth.uid).role == 'admin';
    }
    
    // Checks if the user is owner OR admin
    function isFamilyOwnerOrAdmin(familyId) {
      return isFamilyOwner(familyId) || isFamilyAdmin(familyId);
    }

    // ==========================================
    // GLOBAL RULES
    // ==========================================
    
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Users can only read/write their own profile, settings, and subcollections
    match /users/{userId} {
      allow read, write: if isCurrentUser(userId);
      match /{document=**} {
        allow read, write: if isCurrentUser(userId);
      }
    }
    match /settings/{userId} {
      allow read, write: if isCurrentUser(userId);
    }
    
    // ==========================================
    // HEALTH RECORDS & MEDICATIONS
    // ==========================================
    // Only family members can read/write their family's health records
    match /medicalRecords/{docId} {
      allow read: if isFamilyMember(resource.data.familyId);
      allow create: if isFamilyMember(request.resource.data.familyId);
      allow update: if isFamilyMember(resource.data.familyId) && request.resource.data.familyId == resource.data.familyId;
      allow delete: if isFamilyMember(resource.data.familyId);
    }
    match /medications/{docId} {
      allow read: if isFamilyMember(resource.data.familyId);
      allow create: if isFamilyMember(request.resource.data.familyId);
      allow update: if isFamilyMember(resource.data.familyId) && request.resource.data.familyId == resource.data.familyId;
      allow delete: if isFamilyMember(resource.data.familyId);
    }
    match /medicationLogs/{docId} {
      allow read: if isFamilyMember(resource.data.familyId);
      allow create: if isFamilyMember(request.resource.data.familyId);
      allow update: if isFamilyMember(resource.data.familyId) && request.resource.data.familyId == resource.data.familyId;
      allow delete: if isFamilyMember(resource.data.familyId);
    }
    
    match /chatHistory/{docId} {
      allow read, write: if isCurrentUser(resource.data.uid);
      allow create: if isCurrentUser(request.resource.data.uid);
    }
    match /nutritionHistory/{docId} {
      allow read, write: if isCurrentUser(resource.data.uid);
      allow create: if isCurrentUser(request.resource.data.uid);
    }
    match /alerts/{docId} {
      allow read: if true;
      allow write: if false;
    }
    
    // ==========================================
    // JOIN TOKENS
    // ==========================================
    match /joinTokens/{tokenId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isCurrentUser(request.resource.data.ownerUid); // or just rely on family creation
    }

    // ==========================================
    // FAMILIES
    // ==========================================
    match /families/{familyId} {
      // Any verified family member can read the family
      allow read: if isFamilyMember(familyId);
      
      // Only owner/admin can update family settings, but cannot transfer ownership
      allow update: if isFamilyOwnerOrAdmin(familyId) && request.resource.data.ownerUid == resource.data.ownerUid;
      
      // Only owner can delete the family
      allow delete: if isFamilyOwner(familyId);
      
      // Any authenticated user can create a family (they automatically become owner in familyMembers)
      allow create: if isCurrentUser(request.resource.data.ownerUid);
    }
    
    // ==========================================
    // FAMILY MEMBERS
    // ==========================================
    match /familyMembers/{memberId} {
      // Only verified family members can read the family member list
      allow read: if isFamilyMember(resource.data.familyId);

      allow create: if isSignedIn() && (
        // Scenario A: Local Profile (Owner/Admin creates an unauthenticated dependent)
        (
          isFamilyOwnerOrAdmin(request.resource.data.familyId) &&
          request.resource.data.userId == null &&
          request.resource.data.isLinkedAccount == false &&
          request.resource.data.status == 'local'
        )
        ||
        // Scenario B: Invitation (User joins with link/QR, sets status to pending)
        (
          isCurrentUser(request.resource.data.userId) &&
          request.resource.data.isLinkedAccount == true &&
          (request.resource.data.status == 'pending' || request.resource.data.status == 'linked')
        )
      );
      
      allow update: if isSignedIn() && (
        // Scenario C: Linked Profile updates (User updates their own profile without role escalation)
        (isCurrentUser(resource.data.userId) && request.resource.data.role == resource.data.role)
        ||
        // Scenario A & C Management: Owner/Admin manages any member of their family, cannot create new owners
        (isFamilyOwnerOrAdmin(resource.data.familyId) && (request.resource.data.role != 'owner' || resource.data.role == 'owner'))
      );

      allow delete: if isSignedIn() && (
        // User leaves the family
        isCurrentUser(resource.data.userId)
        ||
        // Admin removes a member (but cannot remove the owner)
        (isFamilyOwnerOrAdmin(resource.data.familyId) && resource.data.role != 'owner')
      );
    }
    
    // ==========================================
    // AUDIT LOGS
    // ==========================================
    match /audit_logs/{docId} {
      // Only Family Members can read audit logs
      allow read: if isFamilyMember(resource.data.familyId);
      
      // Anyone can create an audit log if they are acting on a family
      // For creation, we check if the user is authenticated and performedBy matches
      allow create: if isCurrentUser(request.resource.data.performedBy);
      
      // Audit logs are immutable
      allow update, delete: if false;
    }
  }
}
